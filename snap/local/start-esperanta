#!/bin/sh
set -eu

# Snap services start as root. Drop identity, supplementary groups and
# capabilities before Go starts or reads any administrator-supplied YAML.
# Snap owns the bounding set; changing it requires CAP_SETPCAP, which strict
# confinement does not grant. UID transition clears permitted/effective caps.
exec "$SNAP/usr/bin/setpriv" \
    --reuid=584792 \
    --regid=584792 \
    --clear-groups \
    --inh-caps=-all \
    --ambient-caps=-all \
    --no-new-privs \
    -- "$SNAP/bin/esperanta" \
    --config "$SNAP_DATA/config/config.yaml" "$@"
