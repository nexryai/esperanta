pkgname=esperanta
pkgver=0.1.2
pkgrel=1
pkgdesc="IP-restricted HTTP and HTTPS forward proxy"
arch=('x86_64' 'aarch64')
url="https://github.com/nexryai/esperanta"
license=('MIT')
depends=('ca-certificates' 'systemd')
makedepends=('go')
backup=('etc/esperanta/config.yaml')
# The release workflow replaces the placeholder checksum and version.
source=("esperanta-0.1.2.tar.gz::https://github.com/nexryai/esperanta/archive/refs/tags/v0.1.2.tar.gz")
sha256sums=('94a045d8a7f6d8aa0e6952d35afda7fd8c72832fcd991c50e307328f8f392350')
# The binary is a self-contained static Go build and is already stripped by
# -ldflags '-s -w'. Skipping makepkg's strip/debug steps also lets the same
# PKGBUILD cross-compile the aarch64 package on an x86_64 build host.
options=('!strip' '!debug')

build() {
	cd "$pkgname-$pkgver"

	local -A goarch=([x86_64]=amd64 [aarch64]=arm64)

	export CGO_ENABLED=0
	export GOOS=linux
	export GOARCH="${goarch[$CARCH]:-$CARCH}"
	export GOTOOLCHAIN=auto

	go build -buildvcs=false -trimpath -ldflags '-s -w' -o esperanta ./cmd/esperanta
}

check() {
	cd "$pkgname-$pkgver"

	# A cross-compiled package cannot run its own tests on the build host.
	if [[ $CARCH != "$(uname -m)" ]]; then
		warning "Skipping tests for cross-compiled $CARCH package"
		return 0
	fi

	export CGO_ENABLED=0
	export GOTOOLCHAIN=auto

	# Kernel Landlock behavior is covered by CI.
	go test -skip '^TestKernelSandbox' ./...
}

package() {
	cd "$pkgname-$pkgver"

	install -Dm755 esperanta "$pkgdir/usr/bin/esperanta"
	install -Dm644 systemd/esperanta.service "$pkgdir/usr/lib/systemd/system/esperanta.service"
	install -Dm644 config.yaml "$pkgdir/etc/esperanta/config.yaml"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
